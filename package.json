{
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 62013",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 62013",
    "typecheck": "tsc --noEmit",
    "test:logic": "npx esbuild scripts/check-logic.ts --bundle --platform=node --format=esm --outfile=scripts/check-logic.mjs --log-level=warning && node scripts/check-logic.mjs",
    "test:flow": "npx esbuild scripts/check-flow.ts --bundle --platform=node --format=esm --outfile=scripts/check-flow.mjs --log-level=warning && node scripts/check-flow.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
